{
  "name": "@nafisazizir/engram-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "vercel-build": "pnpm --filter @nafisazizir/engram-core build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/ts-resolve.ts --test \"src/**/*.test.ts\"",
    "keygen": "node --import ./scripts/ts-resolve.ts src/keygen.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nafisazizir/engram-core": "workspace:*",
    "hono": "4.12.34",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
