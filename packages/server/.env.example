# A fine-grained token limited to the memory repo, with Contents: read and write.
GITHUB_TOKEN=
# The memory repo itself (not this code repo).
MEMORY_REPO=nafisazizir/my-mem
# JSON array of clients; add one per device with `pnpm keygen <name> <main|inbox|read-only>`.
ENGRAM_CLIENTS=[]
# Optional. Same secret as the memory repo's push webhook (https://<engram>/webhooks/github).
GITHUB_WEBHOOK_SECRET=
