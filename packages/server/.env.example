# A fine-grained token limited to the memory repo, with Contents: read and write.
GITHUB_TOKEN=
ENGRAM_REPO=nafisazizir/my-mem
ENGRAM_BRANCH=main
# JSON array of clients; add one per device with `pnpm keygen <name> <main|inbox|read-only>`.
ENGRAM_CLIENTS=[]
ENGRAM_TIMEZONE=Australia/Brisbane
# Same secret as the repo's push webhook (Settings → Webhooks → https://<engram>/webhooks/github).
GITHUB_WEBHOOK_SECRET=
